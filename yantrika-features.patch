+def test_spawn_driver_keeps_the_token_out_of_argv(fakerest, api, monkeypatch):
+    """The token is a bearer credential; /proc/<pid>/cmdline is public."""
+    seen: dict[str, object] = {}
+
+    class _FakePopen:
+        def __init__(self, cmd, env=None, **kwargs):
+            seen["cmd"] = cmd
+            seen["env"] = env
+            seen["kwargs"] = kwargs
+            self.pid = 4242
+
