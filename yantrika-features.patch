 # Filtering helpers
 # --------------------------------------------------------------------------
@@ -419,6 +470,8 @@ class FakePostgREST:
                 if name in SITE_TABLES:
                     for r in seeded:  # column default (0005_sites.sql)
                         r.setdefault("site_id", DEFAULT_SITE_ID)
