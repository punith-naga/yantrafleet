[Unit]
Description=YantraFleet incident detector (yantradetect)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=yantra
Group=yantra
EnvironmentFile=/etc/yantrafleet.env
WorkingDirectory=/opt/yantrafleet
ExecStart=/opt/yantrafleet/.venv/bin/python -m yantradetect --interval 5
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
