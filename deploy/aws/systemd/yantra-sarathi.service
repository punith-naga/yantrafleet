[Unit]
Description=Yantrika copilot API (sarathi via uvicorn on 127.0.0.1:8001)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=yantra
Group=yantra
EnvironmentFile=/etc/yantrafleet.env
WorkingDirectory=/opt/yantrafleet/copilot
Environment=PYTHONPATH=/opt/yantrafleet/copilot
ExecStart=/opt/yantrafleet/.venv/bin/python -m uvicorn sarathi.app:app --host 127.0.0.1 --port 8001
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
