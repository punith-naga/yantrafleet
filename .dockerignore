# Keep the Docker build context lean. NOTE: console/ and e2e/fakerest.py are
# runtime dependencies of `yantraops up --loopback` — never ignore those.
.git
.github
.gitignore
.venv
.venv-*
**/__pycache__
**/*.pyc
**/*.egg-info
.pytest_cache
**/.pytest_cache
docker/README.md
TEST-REPORT.md
supabase
scripts
**/eval
**/tests
e2e/test_e2e.py
